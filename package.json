{
  "name": "website-monitor",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Workers 网站变化监测工具（多用户 / Webhook / Resend 邮件通知）",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:init": "wrangler d1 execute website-monitor-db --remote --file=schema.sql",
    "db:init:local": "wrangler d1 execute website-monitor-db --local --file=schema.sql"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "node-html-parser": "^6.1.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "typescript": "^5.7.3",
    "wrangler": "^3.107.3"
  }
}
